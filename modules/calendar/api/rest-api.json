    "POST|DELETE /reminders/v1/settings/taxonomies",
    "GET /reminders/v1/notifications",
    "POST /reminders/v1/notifications/read",
    "GET /reminders/v1/reminders/automation",
    "GET|DELETE /reminders/v1/reminders/automation/{id}/log",
