    "GET|POST /reminders/v1/items?type=reminder",
    "GET|PUT|PATCH|DELETE /reminders/v1/items/{id}?type=reminder",
    "GET /reminders/v1/settings",
    "POST /reminders/v1/settings/field-groups",
