    "GET|PUT|PATCH|DELETE /routines/v1/items/{id}?type=routine",
    "GET /routines/v1/settings",
    "POST /routines/v1/settings/field-groups",
    "GET /routines/v1/cpt-schema/{cpt}",
    "POST|DELETE /routines/v1/settings/taxonomies",
    "GET /routines/v1/notifications",
    "POST /routines/v1/notifications/read",
    "GET /routines/v1/reminders/automation",
    "GET|DELETE /routines/v1/reminders/automation/{id}/log",
    "POST /routines/v1/reminders/automation/test",
    "GET /calendar/v1/calendar.ics",
    "GET /calendar/v1/reminders.ics",
    "GET /calendar/v1/settings",
    "POST /calendar/v1/settings/field-groups",
    "GET /calendar/v1/cpt-schema/{cpt}",
    "POST|DELETE /calendar/v1/settings/taxonomies",
    "GET /calendar/v1/notifications",
    "POST /calendar/v1/notifications/read",
    "GET /calendar/v1/reminders/automation",
    "GET|DELETE /calendar/v1/reminders/automation/{id}/log",
    "POST /calendar/v1/reminders/automation/test"
  ]
